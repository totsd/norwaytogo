<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Simulation</title>
  <!-- Google Font Open Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    body {
      margin: 0;
      font-family: 'Open Sans', sans-serif;
      background-color: #f5f7fa;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      color: #333;
    }
    header {
      background-color: #0d2444;
      color: white;
      padding: 20px;
      text-align: center;
    }
    main {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .payment-form {
      background: white;
      border: 2px solid #d32f2f;
      border-radius: 8px;
      padding: 20px;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .method-buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 15px;
      justify-content: center;
    }
    .method-buttons img {
      width: 60px;
      height: auto;
      cursor: pointer;
      border: 2px solid transparent;
      border-radius: 6px;
      background: #fff;
      padding: 4px;
      box-sizing: content-box;
      transition: border-color 0.2s, transform 0.2s;
    }
    .method-buttons img:hover {
      transform: scale(1.05);
    }
    .method-buttons img.selected {
      border-color: #d32f2f;
    }
    .payment-form label {
      display: block;
      margin-top: 10px;
      font-weight: 600;
    }
    .payment-form input {
      padding: 8px;
      margin-top: 5px;
      margin-bottom: 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
      width: 100%;
      box-sizing: border-box;
    }
    .payment-form button {
      background-color: #d32f2f;
      color: white;
      padding: 12px;
      width: 100%;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      cursor: pointer;
      margin-top: 10px;
    }
    .payment-form button:hover {
      background-color: #b71c1c;
    }
    .result {
      text-align: center;
      margin-top: 15px;
      font-weight: bold;
    }
    footer {
      background-color: #0d2444;
      color: white;
      text-align: center;
      padding: 12px;
      font-size: 14px;
    }
    footer a {
      color: #fff;
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <header><h1>Choose Payment Method</h1></header>

  <main>
    <div class="payment-form">
      <div class="method-buttons" id="methods">
        <img src="https://img.icons8.com/color/96/000000/visa.png" alt="Visa" data-method="Visa" />
        <img src="https://img.icons8.com/color/96/000000/mastercard-logo.png" alt="MasterCard" data-method="MasterCard" />
        <img src="https://img.icons8.com/color/96/000000/amex.png" alt="Amex" data-method="Amex" />
        <img src="https://img.icons8.com/color/96/000000/paypal.png" alt="PayPal" data-method="PayPal" />
        <img src="https://http2.mlstatic.com/frontend-assets/ui-navigation/5.19.1/mercadopago/logo__small.png" alt="Mercado Pago" data-method="Mercado Pago" />
        <img src="https://img.icons8.com/fluency/96/000000/apple-pay.png" alt="Apple Pay" data-method="Apple Pay" />
        <img src="https://img.icons8.com/color/96/000000/google-pay-india.png" alt="Google Pay" data-method="Google Pay" />
      </div>

      <label for="name">Cardholder Name</label>
      <input type="text" id="name" placeholder="John Doe" />
      
      <label for="number">Card Number</label>
      <input type="text" id="number" placeholder="1234 5678 9012 3456" maxlength="19" />
      
      <label for="expiry">Expiry Date (MM/YY)</label>
      <input type="text" id="expiry" placeholder="MM/YY" maxlength="5" />
      
      <label for="cvv">CVV</label>
      <input type="text" id="cvv" placeholder="123" maxlength="4" />
      
      <label for="amount">Amount (USD)</label>
      <input type="number" id="amount" placeholder="100.00" step="0.01" />
      
      <button id="payBtn">Pay</button>
      <div class="result" id="result"></div>
    </div>
  </main>

  <footer>
    Refunds are available. For any help, contact us at
    <a href="mailto:norwaytogo@assist.com">norwaytogo@assist.com</a>
  </footer>

  <script>
    const methods = document.querySelectorAll('#methods img');
    let selected = null;

    methods.forEach(img => {
      img.addEventListener('click', () => {
        methods.forEach(i => i.classList.remove('selected'));
        img.classList.add('selected');
        selected = img.dataset.method;
      });
    });

    document.getElementById('payBtn').addEventListener('click', () => {
      const name = document.getElementById('name').value.trim();
      const number = document.getElementById('number').value.trim();
      const expiry = document.getElementById('expiry').value.trim();
      const cvv = document.getElementById('cvv').value.trim();
      const amount = document.getElementById('amount').value.trim();
      const result = document.getElementById('result');

      if (!selected || !name || !number || !expiry || !cvv || !amount) {
        result.style.color = 'red';
        result.textContent = 'Error: Please fill in all fields and select a payment method.';
        return;
      }

      const success = Math.random() > 0.2;
      if (success) {
        result.style.color = 'green';
        result.textContent = `✔ Payment of $${parseFloat(amount).toFixed(2)} with ${selected} processed successfully.`;
      } else {
        result.style.color = 'red';
        result.textContent = '✘ Error processing payment. Please try again.';
      }
    });
  </script>
</body>
</html>
